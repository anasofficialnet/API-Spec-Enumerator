{
  "name": "aase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "rocketCritical": {
    "dependencies": [
      "next",
      "react",
      "react-dom",
      "@tailwindcss/typography",
      "recharts"
    ],
    "devDependencies": [
      "typescript",
      "@types/node",
      "@types/react",
      "@types/react-dom",
      "@typescript-eslint/eslint-plugin",
      "@typescript-eslint/parser",
      "eslint-config-next",
      "tailwindcss",
      "autoprefixer",
      "postcss",
      "eslint",
      "prettier",
      "@netlify/plugin-nextjs"
    ],
    "scripts": [
      "dev",
      "build",
      "start",
      "lint",
      "lint:fix",
      "format",
      "serve",
      "type-check"
    ],
    "warning": "CRITICAL: DO NOT REMOVE OR MODIFY ABOVE DEPENDENCIES - Required for Next.js 15 TypeScript app functionality"
  },
  "scripts": {
    "clean": "npx rimraf .next out dist build coverage backend/__pycache__ backend/.pytest_cache",
    "dev:fe": "next dev -p 4028",
    "dev:be": "python -m uvicorn backend.main:app --host 127.0.0.1 --port 8010 --reload",
    "dev": "concurrently -n FE,BE -c cyan,green --kill-others-on-fail \"npm run dev:fe\" \"npm run dev:be\"",
    "build": "next build",
    "start": "next start -p 4028",
    "prod:fe": "next build && next start -p 4028",
    "prod:be": "python -m uvicorn backend.main:app --host 127.0.0.1 --port 8010 --workers 4",
    "prod": "concurrently -n FE,BE -c cyan,green --kill-others-on-fail \"npm run prod:fe\" \"npm run prod:be\"",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md,json}\"",
    "serve": "next start -p 4028",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/typography": "^0.5.16",
    "next": "15.1.11",
    "react": "19.0.3",
    "react-dom": "19.0.3",
    "recharts": "^2.15.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "autoprefixer": "10.4.2",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "eslint-config-next": "^15.2.4",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "postcss": "8.4.8",
    "prettier": "^3.5.3",
    "tailwindcss": "3.4.6",
    "typescript": "^5"
  }
}